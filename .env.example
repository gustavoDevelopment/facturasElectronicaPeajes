# Configuración de la aplicación
DEBUG=False
LOG_LEVEL=INFO

# Configuración de directorios
# Por defecto viven en la carpeta de datos del usuario (FACTURAE_HOME para moverla):
#   macOS: ~/Library/Application Support/FacturaeOptimus
#   Windows: %APPDATA%\FacturaeOptimus
# TENANTS_DIR=
# LOG_DIR=

# Carpeta de salida (ZIPs, vouchers y Excel; una subcarpeta por tenant).
# También se puede definir desde la aplicación (settings.json).
# OUTPUT_DIR=~/Documents/Causa Peajes

# Configuración de logging
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s
LOG_FILE=facturae_optimus.log

# Configuración de la aplicación
DEFAULT_ENCODING=utf-8

# Carpeta de secretos por tenant (email.json, gmail_token.json). Fuera del repo.
# Por defecto: ~/.facturae_optimus/secrets
# SECRETS_DIR=~/.facturae_optimus/secrets
